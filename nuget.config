<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
    Удаляем источники, настроенные глобавльно на компьютере.
    Благодаря этому сборка будет одинаковой у разных разработчиков
    -->
    <clear />
    <!--
    Публичный источник NuGet
    Здесь находятся Microsoft-пакеты, Serilog, Npgsql, xUnit и другие
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
    Приватный GitHub Packages repository FrMks.
    Здесь находятся внутренние пакеты Shared.
    -->
    <add key="github" value="https://nuget.pkg.github.com/FrMks/index.json" />
  </packageSources>

  <!--
      Правила сопоставления пакетов с источниками.

      Они не дают NuGet искать внутренние Shared.* пакеты
      в публичном nuget.org.
    -->
  <packageSourceMapping>
      <!--
           Все обычные внешние пакеты берём из nuget.org.
        -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>

    <!--
          Все пакеты с именем Shared.* берём из GitHub Packages.
        -->
    <packageSource key="github">
      <package pattern="Shared.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
